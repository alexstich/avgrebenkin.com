        <p class="fhint">{{t:calc.16}}</p>
      </div>
      <div class="field">
        <label for="term">{{t:calc.17}}</label>
        <div class="seg" role="group" aria-label="{{ta:calc.05}}" id="term">
          <button type="button" data-v="10">{{t:calc.18}}</button><button type="button" data-v="15">{{t:calc.19}}</button><button type="button" data-v="20">{{t:calc.20}}</button><button type="button" data-v="25">{{t:calc.21}}</button><button type="button" data-v="30" aria-pressed="true">{{t:calc.22}}</button>
        </div>
        <p class="fhint">{{t:calc.23}}</p>
      </div>
      <div class="field">
        <label for="rate">{{t:calc.24}}</label>
        <div class="inrow">
          <input id="rate" type="number" inputmode="decimal" min="0" max="25" step="0.05" placeholder="{{ta:calc.06}}">
          <button type="button" class="minibtn" id="rate-x" hidden>{{t:calc.25}}</button>
        </div>
        <p class="fhint" id="ratehint">{{t:calc.26}}</p>
      </div>
      <div class="field">
        <label for="dep">{{t:calc.27}}</label>
        <input id="dep" type="range" min="0" max="40" step="5" value="0">
        <p class="fhint">{{t:calc.28}}</p>
      </div>
      <div class="field">
        <label>{{t:calc.29}}</label>
        <div class="inrow hh">
          <span class="stepper"><button type="button" data-hh="adults" data-d="-1" aria-label="{{ta:calc.07}}">−</button><b id="adults-o">1</b><button type="button" data-hh="adults" data-d="1" aria-label="{{ta:calc.08}}">+</button><i>{{t:calc.30}}</i></span>
