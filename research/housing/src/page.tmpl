        <span>{{t:ui.tldrPrint}}</span>
      </button>
      <button type="button" class="tldr-btn tldr-x" id="tldrClose" title="{{ta:ui.tldrClose}}" aria-label="{{ta:ui.tldrClose}}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="tldr-doc" id="tldrDoc">
      <h2 id="tldrTitle">{{title}}</h2>
      <p class="tldr-sub">{{t:tldr.sub}}</p>
      <ul>
