        <span>{{t:ui.tldrCopyText}}</span>
      </button>
      <button type="button" class="tldr-btn" data-tldr-copy="md" title="{{ta:ui.tldrCopyMd}}" aria-label="{{ta:ui.tldrCopyMd}}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 15V9l2.5 3L12 9v6M16 9v4.5M16 13.5l2 2 2-2"/></svg>
        <span>{{t:ui.tldrCopyMd}}</span>
      </button>
      <button type="button" class="tldr-btn" id="tldrPrint" title="{{ta:ui.tldrPrint}}" aria-label="{{ta:ui.tldrPrint}}">
