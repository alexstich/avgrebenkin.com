  <!-- Короткая версия: собрана из фраз и чисел самой страницы, ничего нового
       здесь не утверждается. Копируется текстом или Markdown и печатается
       отдельным листом, всегда со ссылкой на страницу на том же языке. -->
  <dialog class="tldr" id="tldr" aria-labelledby="tldrTitle">
