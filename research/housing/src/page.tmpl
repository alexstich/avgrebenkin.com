        <label for="inc">{{t:calc.13}}</label>
        <div class="inrow">
          <input id="inc" type="number" inputmode="decimal" min="0" step="50" placeholder="{{ta:calc.03}}">
          <select id="cur" aria-label="{{ta:calc.04}}"></select>
