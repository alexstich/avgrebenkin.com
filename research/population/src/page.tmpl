<body>

<nav class="site-nav" id="site-nav">
  <a href="/" class="nav-name">Aleksei Grebenkin</a>
  <div class="nav-links" id="nav-links">
    <a href="/#projects" class="nav-link">Projects</a>
    <a href="/#notes" class="nav-link">Notes</a>
    <a href="/research/" class="nav-link nav-link-active">Research</a>
    <a href="/#speaking" class="nav-link">Speaking</a>
    <a href="/#certifications" class="nav-link">Certifications</a>
    <a href="/#journey" class="nav-link">Journey</a>
    <a href="/#contacts" class="nav-link">Contacts</a>
  </div>
  <div class="nav-controls">
    <div class="theme-switcher" id="theme-switcher" role="radiogroup" aria-label="Color theme">
      <button type="button" class="theme-btn" data-theme="dark" role="radio" aria-label="Dark theme" aria-checked="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button type="button" class="theme-btn" data-theme="light" role="radio" aria-label="Light theme" aria-checked="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" class="theme-btn" data-theme="cyber" role="radio" aria-label="Cyberpunk theme" aria-checked="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>
      </button>
    </div>
    <button type="button" class="nav-burger" id="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
      <span class="nav-burger-line"></span>
      <span class="nav-burger-line"></span>
      <span class="nav-burger-line"></span>
    </button>
  </div>
</nav>

<main id="top">
<div class="wrap">
  <p class="crumb">{{t:top.crumb}}</p>

  <header class="hero">
    <img class="cover" src="{{up}}../images/research/population-page.webp"
         alt="{{imageAlt}}" width="1600" height="560" fetchpriority="high" decoding="async">
    <div class="htop">
      <h1>{{t:hero.h1}}</h1>
      <button type="button" class="sharebtn" id="share" title="{{ta:hero.shareTitle}}">{{svgShare}}<span>{{t:hero.share}}</span></button>
    </div>
    <p class="sub">{{t:hero.sub}}</p>
    <div class="meta">{{t:hero.meta}}</div>
  </header>

  <div class="modebar">
    <button type="button" class="tldr-open" id="tldrOpen" aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 11h16M4 16h9"/></svg>
      {{t:ui.tldrOpen}}
      <span class="tldr-open-sub">{{t:ui.tldrOpenSub}}</span>
    </button>
    {{langpicker}}
  </div>

  <!-- Короткая версия: собрана из фраз и чисел самой страницы, ничего нового
       здесь не утверждается. Копируется текстом или Markdown и печатается
       отдельным листом, всегда со ссылкой на страницу на том же языке. -->
  <dialog class="tldr" id="tldr" aria-labelledby="tldrTitle">
    <div class="tldr-bar">
      <p class="tldr-kicker">{{t:ui.tldrHead}}</p>
      <button type="button" class="tldr-btn" data-tldr-copy="text" title="{{ta:ui.tldrCopyText}}" aria-label="{{ta:ui.tldrCopyText}}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
        <span>{{t:ui.tldrCopyText}}</span>
      </button>
      <button type="button" class="tldr-btn" data-tldr-copy="md" title="{{ta:ui.tldrCopyMd}}" aria-label="{{ta:ui.tldrCopyMd}}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 15V9l2.5 3L12 9v6M16 9v4.5M16 13.5l2 2 2-2"/></svg>
        <span>{{t:ui.tldrCopyMd}}</span>
      </button>
      <button type="button" class="tldr-btn" id="tldrPrint" title="{{ta:ui.tldrPrint}}" aria-label="{{ta:ui.tldrPrint}}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 9V3.8h10V9"/><path d="M7 17.5H4.6v-6A2.4 2.4 0 0 1 7 9h10a2.4 2.4 0 0 1 2.4 2.4v6H17"/><path d="M7 14.4h10v5.8H7z"/></svg>
        <span>{{t:ui.tldrPrint}}</span>
      </button>
      <button type="button" class="tldr-btn tldr-x" id="tldrClose" title="{{ta:ui.tldrClose}}" aria-label="{{ta:ui.tldrClose}}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="tldr-doc" id="tldrDoc">
      <h2 id="tldrTitle">{{title}}</h2>
      <p class="tldr-sub">{{t:tldr.sub}}</p>
      <ul>
        <li>{{t:tldr.b1}}</li>
        <li>{{t:tldr.b2}}</li>
        <li>{{t:tldr.b3}}</li>
        <li>{{t:tldr.b4}}</li>
        <li>{{t:tldr.b5}}</li>
      </ul>
      <p class="tldr-src">{{t:tldr.src}}</p>
      <p class="tldr-link">{{t:tldr.full}} {{canonical}}</p>
    </div>
  </dialog>

  <aside class="sy-strip" aria-label="Speak-Y">
    <span class="sy-brand">
      <img class="sy-icon" src="{{up}}../images/icons/speak-y.webp" alt="" width="48" height="48" loading="lazy" decoding="async">
      <span class="sy-name">Speak-<i>Y</i></span>
    </span>
    <p>{{t:ui.syText}}</p>
    <a class="sy-go" href="https://speak-y.com/invite/33BW7" target="_blank" rel="noopener">{{t:ui.syCta}} <span aria-hidden="true">→</span></a>
  </aside>

  <!-- 1. Прокрутка двигает время ─────────────────────────────────── -->
  <section class="part prose" id="scroll">
    <h2>{{t:scroll.h2}}</h2>
    <p>{{t:scroll.p1}}</p>
    <p>{{t:scroll.p2}}</p>
    <div class="scroller">
      <div class="sticky stage">
        <canvas class="globe" aria-label="{{ta:scroll.globeLabel}}"></canvas>
        <div class="prog"></div>
        <div class="ov ov-tr"><div class="seg" data-viewseg role="group" aria-label="{{ta:view.label}}"><button type="button" data-v="dots">{{t:view.dots}}</button><button type="button" data-v="density">{{t:view.density}}</button></div></div>
        <div class="center"><div class="huge" data-num></div><div class="unit" data-unit></div><div class="when" data-year></div></div>
        <div class="miles" data-miles></div>
        <div class="cap"><span class="tiny" data-src></span><span data-cap></span></div>
      </div>
    </div>
  </section>

  <!-- 2. Глобус с плеером и паспорт цифры под ним ─────────────────── -->
  <section class="part prose" id="play">
    <h2>{{t:play.h2}}</h2>
    <p>{{t:play.p1}}</p>
    <p>{{t:play.p2}}</p>
    <div class="ctlrow">
      <div class="ctl"><span>{{t:view.label}}</span><div class="seg" data-viewseg role="group" aria-label="{{ta:view.label}}"><button type="button" data-v="dots">{{t:view.dots}}</button><button type="button" data-v="density">{{t:view.density}}</button></div></div>
      <div class="ctl"><span>{{t:play.from}}</span><div class="seg" id="c-start" role="group" aria-label="{{ta:play.from}}"><button type="button" data-v="-10000">{{t:play.y10000}}</button><button type="button" data-v="-5000">{{t:play.y5000}}</button><button type="button" data-v="0">{{t:play.y1}}</button><button type="button" data-v="1800">{{t:play.y1800}}</button></div></div>
      <div class="ctl"><span>{{t:play.pace}}</span><div class="seg" id="c-mode" role="group" aria-label="{{ta:play.pace}}"><button type="button" data-v="linear">{{t:play.linear}}</button><button type="button" data-v="log">{{t:play.log}}</button><button type="button" data-v="doubling">{{t:play.doubling}}</button></div></div>
    </div>
    <p class="pacehint" id="pacehint" aria-live="polite"></p>
    <div class="stage" id="main">
      <div class="view">
        <canvas class="globe" aria-label="{{ta:play.globeLabel}}"></canvas>
        <div class="ov ov-tl"><div class="big" data-num></div><div class="yr" data-year></div></div>
        <div class="ov ov-bl"><span class="chip" data-src></span></div>
        <div class="ov ov-br" data-legend></div>
        <div class="tip" role="status"></div>
      </div>
      <div class="player"></div>
      <div class="passport">
        <canvas class="chart" aria-label="{{ta:play.chartLabel}}"></canvas>
        <div class="pass">
          <h3>{{t:play.passHead}}</h3>
          <p class="yr" data-pyear></p>
          <div class="num" data-pnum></div>
          <div class="src" data-psrc></div>
          <p class="cite" data-cite></p>
          <p class="how" data-how></p>
          <h4 data-esth></h4>
          <div class="estrip" data-strip></div>
          <ul class="estl" data-estl></ul>
          <p class="spread" data-spread></p>
        </div>
      </div>
    </div>
    <p class="note">{{t:play.note}}</p>
  </section>

  <!-- 3. Страна против мира ────────────────────────────────────────── -->
  <section class="part prose country" id="country">
    <h2>{{t:country.h2}}</h2>
    <p>{{t:country.p1}}</p>
    <p>{{t:country.p2}}</p>
    <div class="stage">
      <div class="filters">
        <label>{{t:country.country}}<select id="cc"></select></label>
        <label>{{t:country.from}}<select id="cf"></select></label>
        <label>{{t:country.to}}<select id="ct"></select></label>
      </div>
      <div class="split">
        <div class="view"><canvas class="globe" aria-label="{{ta:country.globeLabel}}"></canvas>
          <div class="ov ov-bl"><span class="chip" data-src></span></div></div>
        <div class="cpanel" aria-live="off">
          <div><div class="cname" data-cname></div><div class="yr" data-year></div></div>
          <div class="kv">
            <div><b data-cpop></b><span>{{t:country.people}}</span></div>
            <div><b data-cshare></b><span>{{t:country.ofWorld}}</span></div>
            <div><b data-crank></b><span>{{t:country.rank}}</span></div>
            <div><b data-cgrow></b><span data-cgrowl></span></div>
          </div>
          <div><div class="tiny">{{t:country.share}}</div><canvas class="mini" aria-hidden="true"></canvas></div>
        </div>
      </div>
      <div class="player"></div>
    </div>
  </section>

  <!-- 4. Девять кадров ─────────────────────────────────────────────── -->
  <section class="part prose" id="frames">
    <h2>{{t:frames.h2}}</h2>
    <p>{{t:frames.p}}</p>
    <div class="stage"><div class="frames" data-frames></div></div>
    <dialog class="lb" id="lb" aria-label="{{ta:frames.dialog}}">
      <div class="lb-top"><div><b data-lby></b><span data-lbn></span></div>
        <div class="lb-btns"><button type="button" data-lbprev aria-label="{{ta:frames.prev}}">←</button><button type="button" data-lbnext aria-label="{{ta:frames.next}}">→</button><button type="button" data-lbclose aria-label="{{ta:frames.close}}">✕</button></div></div>
      <div class="lb-map"><canvas aria-label="{{ta:frames.mapLabel}}"></canvas></div>
      <p class="lb-foot" data-lbf></p>
    </dialog>
  </section>

  <!-- 5. Где цифры слабы ───────────────────────────────────────────── -->
  <section class="part prose" id="weak">
    <h2>{{t:weak.h2}}</h2>
    <p>{{t:weak.p1}}</p>
    <p>{{t:weak.p2}}</p>
    <p>{{t:weak.p3}}</p>
    <h3>{{t:weak.srcH}}</h3>
    <ul class="srcs">
      <li>{{t:weak.s1}}</li>
      <li>{{t:weak.s2}}</li>
      <li>{{t:weak.s3}}</li>
      <li>{{t:weak.s4}}</li>
      <li>{{t:weak.s5}}</li>
      <li>{{t:weak.s6}}</li>
    </ul>
    {{translationNote}}
  </section>
</div>
</main>

<footer>
  <span>© 2026 Aleksei Grebenkin</span> <a class="to-top" href="#top">↑ top</a>
</footer>

<script src="{{up}}shell.js?v=5"></script>
