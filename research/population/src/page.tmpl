<script>
  /* the theme before first paint, so a light reader never sees a dark flash */
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (['dark', 'light', 'cyber'].indexOf(t) === -1) {
        t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
    document.documentElement.classList.add('js');
  })();
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{canonical}}#webpage",
      "url": "{{canonical}}",
      "name": "{{ldTitle}}",
      "description": "{{ldDescription}}",
      "isPartOf": { "@id": "https://avgrebenkin.com/#website" },
      "author": { "@id": "https://avgrebenkin.com/#person" },
      "datePublished": "2026-09-30",
      "dateModified": "2026-09-30",
      "inLanguage": "{{lang}}",
      {{ldTranslations}}
      "breadcrumb": { "@id": "{{canonical}}#breadcrumb" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://avgrebenkin.com/images/research/population.jpg",
        "width": 1200,
        "height": 630
      },
      "mainEntity": { "@id": "{{canonical}}#dataset" }
    },
    {
      "@type": "Dataset",
      "@id": "{{canonical}}#dataset",
      "name": "{{ldDatasetName}}",
      "description": "{{ldDatasetDescription}}",
      "creator": { "@id": "https://avgrebenkin.com/#person" },
      "datePublished": "2026-09-30",
      "temporalCoverage": "-10000/2023",
      "spatialCoverage": { "@type": "Place", "name": "World; 165 countries in today's borders" },
      "measurementTechnique": [
        "Our World in Data population series: HYDE 3.3 reconstruction up to 1800, Gapminder v7 from 1800 to 1949, UN World Population Prospects 2024 from 1950",
        "Between published points the population is interpolated geometrically, assuming steady growth",
        "One dot per million people, placed at random inside each country's Natural Earth 1:110m outline",
        "Independent estimates of world population before 1950 by the Population Reference Bureau, the United Nations, Maddison, HYDE 3.1, Biraben, McEvedy and Jones, Thomlinson, Durand and Clark, as compiled by the US Census Bureau and Wikipedia"
      ],
      "variableMeasured": [
        { "@type": "PropertyValue", "name": "population", "description": "Number of people living on the territory of a present-day country, or in the world" },
        { "@type": "PropertyValue", "name": "density", "description": "People per square kilometre of the present-day country's area" },
        { "@type": "PropertyValue", "name": "share", "description": "A country's share of world population, in per cent" }
      ],
      "isAccessibleForFree": true,
      "keywords": ["world population", "population history", "HYDE", "Our World in Data", "UN World Population Prospects", "demography", "doubling time"],
      "isBasedOn": "https://ourworldindata.org/grapher/population"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{canonical}}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://avgrebenkin.com/" },
        { "@type": "ListItem", "position": 2, "name": "Research", "item": "https://avgrebenkin.com/research/" },
        { "@type": "ListItem", "position": 3, "name": "{{ldName}}", "item": "{{canonical}}" }
      ]
    }
  ]
}
</script>

