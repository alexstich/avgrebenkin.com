<main>
<div class="wrap" id="hf">
  <p class="crumb"><a href="/research/">{{crumb}}</a></p>

  <header>
    <h1>{{title}}</h1>
    <p class="sub">{{subtitle}}</p>
    <div class="gist">{{gist}}</div>
    <div class="meta">
      <span>{{date}}</span>
      <span>{{sourcesLine}}</span>
      <span>{{scaleLine}}</span>
    </div>
    <button type="button" class="tldr-open" data-tldr-open aria-haspopup="dialog">{{tldrOpen}}</button>
  </header>

  <!-- Краткая версия. Всё внутри — те же строки, что и в статье, поэтому
       пересказ не может с ней разойтись. Диалог нативный: Esc, фокус и
       подложка достаются даром. -->
  <dialog class="tldr" id="tldr" aria-label="{{tldrHead}}">
    <div class="tldr-inner">
      <div class="tldr-body">{{tldrBody}}</div>
      <div class="tldr-acts">
        <button type="button" data-tldr-copy="text">{{tldrCopyText}}</button>
        <button type="button" data-tldr-copy="md">{{tldrCopyMd}}</button>
        <button type="button" data-tldr-print>{{tldrPrint}}</button>
        <button type="button" data-tldr-close class="tldr-close">{{tldrClose}}</button>
      </div>
    </div>
  </dialog>

  <div class="modebar">
    {{langpicker}}
  </div>

  <section aria-labelledby="h-numbers">
    <h2 id="h-numbers" class="sr-only">{{hNumbers}}</h2>
    {{numbers}}
  </section>

  <section aria-labelledby="h-what">
    <h2 id="h-what">{{hWhat}}</h2>
    {{intro}}
  </section>

  <section aria-labelledby="h-legend">
    <h2 id="h-legend">{{hLegend}}</h2>
    <div class="h2note">{{nLegend}}</div>
    {{legend}}
  </section>

  <section aria-labelledby="h-explorer" id="explorer">
    <h2 id="h-explorer">{{hExplorer}}</h2>
    <div class="h2note">{{nExplorer}}</div>

    <div class="explorer">
      <div class="exbar">
        <div class="ribbon" id="ribbon" role="group" aria-label="{{actsGroup}}"></div>
        <div class="exbar-foot">
          <span class="counter">{{counterFull}}</span>
          <span class="exhint">{{utcHint}}</span>
        </div>
        <div class="progress" aria-hidden="true"><i></i></div>
      </div>
      <div class="timeline" id="timeline">
{{timeline}}
      </div>
    </div>
  </section>

  <section aria-labelledby="h-div">
    <h2 id="h-div">{{hDiv}}</h2>
    <div class="h2note">{{nDiv}}</div>
    {{divergences}}
  </section>

  <section aria-labelledby="h-facts">
    <h2 id="h-facts">{{hFacts}}</h2>
    <div class="h2note">{{nFacts}}</div>
    {{facts}}
  </section>

  <aside class="sy-strip" aria-label="Speak-Y">
    <span class="sy-name">Speak-<i>Y</i></span>
    <p>{{syText}}</p>
    <a class="sy-go" href="https://speak-y.com/invite/33BW7" target="_blank" rel="noopener">{{syCta}} <span aria-hidden="true">→</span></a>
  </aside>

  <section aria-labelledby="h-sources">
    <h2 id="h-sources">{{hSources}}</h2>
    <div class="h2note">{{nSources}}</div>
    {{sources}}
    <p class="disclaimer">{{disclaimer}}</p>
    {{translationNote}}
  </section>

</div>
</main>

<footer>
  <span>© 2026 Aleksei Grebenkin</span>
  <a class="to-top" href="/research/">{{backToResearch}}</a>
</footer>

