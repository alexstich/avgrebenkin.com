<!-- Короткая версия для тех, кто не будет читать целиком, и для тех, кто хочет
     унести её к себе. Собрана из фраз и цифр самой статьи — ничего нового здесь
     не утверждается. Копируется текстом или Markdown и печатается отдельным
     листом, всегда со ссылкой на исходную страницу. -->
<dialog class="tldr" id="tldr" aria-labelledby="tldrTitle">
  <div class="tldr-bar">
    <p class="tldr-kicker">{{ui.tldrHead}}</p>
    <button type="button" class="tldr-btn" data-tldr-copy="text" title="{{a:ui.tldrCopyText}}" aria-label="{{a:ui.tldrCopyText}}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
      <span>{{ui.tldrCopyText}}</span>
    </button>
    <button type="button" class="tldr-btn" data-tldr-copy="md" title="{{a:ui.tldrCopyMd}}" aria-label="{{a:ui.tldrCopyMd}}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 15V9l2.5 3L12 9v6M16 9v4.5M16 13.5l2 2 2-2"/></svg>
      <span>{{ui.tldrCopyMd}}</span>
    </button>
    <button type="button" class="tldr-btn" id="tldrPrint" title="{{a:ui.tldrPrint}}" aria-label="{{a:ui.tldrPrint}}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 9V3.8h10V9"/><path d="M7 17.5H4.6v-6A2.4 2.4 0 0 1 7 9h10a2.4 2.4 0 0 1 2.4 2.4v6H17"/><path d="M7 14.4h10v5.8H7z"/></svg>
      <span>{{ui.tldrPrint}}</span>
    </button>
    <button type="button" class="tldr-btn tldr-x" id="tldrClose" title="{{a:ui.tldrClose}}" aria-label="{{a:ui.tldrClose}}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="tldr-doc" id="tldrDoc">
    <h2 id="tldrTitle">{{page.title}}</h2>
    <p class="tldr-sub">{{tldr.sub}}</p>
    <ul>
      <li>{{tldr.b1|p}}</li>
      <li>{{tldr.b2|p}}</li>
      <li>{{tldr.b3|p}}</li>
      <li>{{tldr.b4|p}}</li>
      <li>{{tldr.b5|p}}</li>
      <li>{{tldr.b6|p}}</li>
      <li>{{tldr.b7|p}}</li>
    </ul>
    <p class="tldr-src">{{tldr.src}}</p>
    <p class="tldr-link">{{tldr.full}} {{canonical}}</p>
  </div>
</dialog>

