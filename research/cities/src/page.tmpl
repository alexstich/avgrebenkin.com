        <h3>{{ctlPresetsH}}</h3>
        <p class="subhint">{{ctlPresetsNote}}</p>
        <div class="presetrow" id="presets"></div>
      </div>
      <p class="subhint whint">{{ctlSlidersNote}}</p>
      <div class="weights" id="weights"></div>
    </div>
  </details>

  <div class="panel chartbox" id="p-chart">
