      <div class="pactions"><button type="button" class="ibtn" data-share title="{{copySetup}}" aria-label="{{copySetup}}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.4 10.8 15.6 6.4M8.4 13.2l7.2 4.4"/></svg></button><button type="button" class="ibtn" data-png title="{{copyPNG}}" aria-label="{{copyPNG}}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.2" y="5" width="17.6" height="14" rx="2.4"/><circle cx="8.6" cy="10" r="1.5"/><path d="m4.4 16.6 4.4-4 3.4 3 3-2.6 4.4 4"/></svg></button><button type="button" class="ibtn" data-png-dl title="{{downloadPNG}}" aria-label="{{downloadPNG}}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v10.4"/><path d="m7.6 10.6 4.4 4.4 4.4-4.4"/><path d="M4.8 19.2h14.4"/></svg></button><button type="button" class="ibtn" data-print="chart" title="{{printChart}}" aria-label="{{printChart}}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 9V3.8h10V9"/><path d="M7 17.5H4.6v-6A2.4 2.4 0 0 1 7 9h10a2.4 2.4 0 0 1 2.4 2.4v6H17"/><path d="M7 14.4h10v5.8H7z"/></svg></button></div>
      <h2>{{chartH}}</h2>
      <p>{{chartP}}</p>
    </div>
    <div class="bar">
      <div class="legend" id="legend" role="group" aria-label="{{filterRegion}}"></div>
      <div class="toggle">
        <span>{{cost}}</span>
        <div class="seg" role="group" aria-label="{{costGroup}}">
          <button type="button" id="mode-rent" aria-pressed="true">{{withRent}}</button>
          <button type="button" id="mode-norent" aria-pressed="false">{{withoutRent}}</button>
        </div>
      </div>
    </div>
    <p class="barhint">{{chartBarhint}}</p>
    <p class="note" id="moneynote" hidden>{{chartMoneynote}}</p>
    <svg id="chart" viewBox="0 0 1000 720" role="img" aria-label="{{chartAlt}}"></svg>
    <div class="tip" id="tip"></div>
    <div class="quadkey">
      <div class="qk qk-best"><b>{{qBestT}}</b><span>{{qBestD}}</span></div>
      <div class="qk qk-premium"><b>{{qPremiumT}}</b><span>{{qPremiumD}}</span></div>
      <div class="qk qk-budget"><b>{{qBudgetT}}</b><span>{{qBudgetD}}</span></div>
      <div class="qk qk-bad"><b>{{qBadT}}</b><span>{{qBadD}}</span></div>
    </div>
  </div>


  <section class="panel ranklist" id="p-list">
